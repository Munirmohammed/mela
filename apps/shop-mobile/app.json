{
  "expo": {
    "name": "Mela",
    "slug": "mela-shop",
    "version": "1.0.0",
    "scheme": "mela",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f0f0f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "et.digicom.mela"
    },
    "android": {
      "package": "et.digicom.mela",
      "adaptiveIcon": {
        "backgroundColor": "#0f0f0f"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"]
  }
}
